# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub.

# Your Creditcoin Testnet RPC URL
RPC_URL=https://rpc.cc3-testnet.creditcoin.network/

# Your MetaMask wallet's PRIVATE KEY (exported from MetaMask -> Account Details -> Export Private Key)
# This wallet needs tCTC in it to pay gas fees.
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# The deployed contract address you're calling (fill in once you deploy your action/verify contract)
CONTRACT_ADDRESS=0xYourContractAddressHere

# Port this server runs on locally
PORT=4000
